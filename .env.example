# Myriapod frontend config. NO API keys here — the browser never holds a key
# (the OpenRouter keys live server-side in proxy/.env). Copy to .env.local for
# local dev; set the same vars in the deploy environment (or a .env.production
# file) for a production build.
#
# All three endpoints default to local/dev targets when unset; a production
# build MUST override them with the public HTTPS endpoints. The build-time
# CSP connect-src is derived from these, so setting them also scopes the CSP —
# no separate CSP edit needed. STT and TTS ride the metering proxy's audio routes,
# so in production all three share the one proxy origin (same-origin https).

# The metering proxy origin (chat + embed + web-search + audio on owner-funded paths).
#   dev:  http://127.0.0.1:8790/v1
#   prod: https://<proxy-host>/v1
VITE_PROXY_BASE=http://127.0.0.1:8790/v1

# Batch speech-to-text — the proxy's /v1/audio/transcriptions route. The proxy
# injects the owner key and forwards to a cloud audio provider (or your own
# OpenAI-compatible ASR). The browser POSTs a 16-bit mono WAV as multipart/form-data.
#   dev:  http://127.0.0.1:8790/v1/audio/transcriptions
#   prod: https://<proxy-host>/v1/audio/transcriptions
VITE_STT_BASE=http://127.0.0.1:8790/v1/audio/transcriptions

# Sentence-batched text-to-speech — the proxy's /v1/audio/speech route. The proxy
# injects the owner key + default voice and forwards to a cloud audio provider (or
# your own OpenAI-compatible speech server). One HTTP POST per sentence.
#   dev:  http://127.0.0.1:8790/v1/audio/speech
#   prod: https://<proxy-host>/v1/audio/speech
VITE_TTS_BASE=http://127.0.0.1:8790/v1/audio/speech

# Voice-session broker (vestigial). Leave off (0): the cloud audio routes are shared
# and stateless, so there is nothing to lease.
VITE_VOICE_BROKER=0
