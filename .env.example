# Myriapod frontend config. NO API keys here — the browser never holds a key
# (the OpenRouter keys live server-side in proxy/.env). Copy to .env.local for
# local dev; set the same vars in the deploy environment (or a .env.production
# file) for a production build.
#
# All three endpoints default to local/dev targets when unset; a production
# build MUST override them with the public HTTPS/WSS endpoints. The build-time
# CSP connect-src is derived from these, so setting them also scopes the CSP —
# no separate CSP edit needed.

# The metering proxy origin (chat + embed + web-search on owner-funded paths).
#   dev:  http://127.0.0.1:8790/v1
#   prod: https://<proxy-host>/v1
VITE_PROXY_BASE=http://127.0.0.1:8790/v1

# Whisper ASR HTTP endpoint (batch speech-to-text).
#   dev:  http://localhost:8123/api/asr-http   (local tunnel)
#   prod: https://<voice-host>/api/asr-http
VITE_STT_BASE=http://localhost:8123/api/asr-http

# moshi TTS WebSocket (streaming text-to-speech).
#   dev:  ws://localhost:8123/api/tts_streaming   (local tunnel)
#   prod: wss://<voice-host>/api/tts_streaming
# VITE_TTS_BASE=ws://localhost:8123/api/tts_streaming

# Voice-concurrency broker. 1/true routes voice through the proxy's /voice/*
# broker (leased instances + overflow queue); requires the proxy's voice config.
VITE_VOICE_BROKER=1
