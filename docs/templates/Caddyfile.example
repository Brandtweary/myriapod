# Myriapod one-box reverse proxy — sanitized Caddyfile.
#
# Serves the built SPA, proxies the metering-proxy API, and auto-provisions
# HTTPS from Let's Encrypt. TLS is not optional: the mic (getUserMedia) requires
# a secure context. Speech-to-text and text-to-speech ride the metering proxy's
# /v1/audio/* routes (owner-key injected, forwarded to a cloud audio provider),
# so they need no dedicated upstream — the /v1/* block below already covers them.
#
# Replace your-domain.example with a real domain you control — Caddy will fetch
# and renew its certificate automatically. Point the upstream address at
# wherever your metering proxy actually listens.

your-domain.example {
	# --- The metering proxy (API only) ---------------------------------------
	# The proxy serves no static files — only these API routes. It listens on
	# 127.0.0.1:8790. Caddy forwards X-Forwarded-For automatically, so set the
	# proxy's TRUSTED_PROXY=127.0.0.1 to read the real visitor IP from it.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8790
	}
	handle /anon-init {
		reverse_proxy 127.0.0.1:8790
	}
	handle /redeem {
		reverse_proxy 127.0.0.1:8790
	}
	handle /balance {
		reverse_proxy 127.0.0.1:8790
	}
	handle /voice/* {
		reverse_proxy 127.0.0.1:8790
	}
	handle /health {
		reverse_proxy 127.0.0.1:8790
	}
	handle /subscribe {
		reverse_proxy 127.0.0.1:8790
	}

	# --- Speech (STT + TTS) --------------------------------------------------
	# No dedicated blocks: VITE_STT_BASE / VITE_TTS_BASE point at this origin's
	# /v1/audio/transcriptions and /v1/audio/speech, which the /v1/* handle above
	# already forwards to the metering proxy. The proxy injects the owner key and
	# forwards to a cloud audio provider.
	#
	# OPTIONAL — self-host speech instead: run your own OpenAI-compatible ASR/TTS
	# (see docker-compose.yml) and point VITE_STT_BASE / VITE_TTS_BASE at dedicated
	# routes here that proxy to those containers, e.g.:
	#   handle /api/asr-http {
	#       rewrite * /v1/audio/transcriptions
	#       reverse_proxy 127.0.0.1:8000
	#   }

	# --- The built SPA (catch-all) -------------------------------------------
	# `npm run build` emits dist/. Everything not matched above serves the SPA,
	# with a fallback so client-side routes resolve to index.html instead of 404.
	# This block is LAST so the API and voice routes above take precedence.
	handle {
		root * /var/www/myriapod/dist
		try_files {path} /index.html
		file_server
	}
}
