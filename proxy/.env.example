# myriapod-proxy configuration. Copy to .env and fill in.
# The proxy reads these via Bun's automatic .env loading.

# --- OpenRouter keys (mint these in the OpenRouter dashboard) ---------------
# The owner key the proxy spends on behalf of free-tier (IP) visitors. NEVER
# shipped to the browser — this is the whole reason the proxy exists.
OWNER_OPENROUTER_KEY=

# A management-only "provisioning" key (cannot run completions). Lets /redeem
# mint per-family-code sub-keys with a hard spend limit. Leave blank to disable
# the family tier (redemption returns 503).
OPENROUTER_PROVISIONING_KEY=

# Hard lifetime spend cap (USD) on each minted family sub-key. Configurable;
# $100 to start. Enforced by OpenRouter itself, not just our metering.
FAMILY_LIMIT=100

# --- Free tier (anonymous, IP-metered) -------------------------------------
FREE_GRANT_USD=10        # one-time lifetime credit granted per new IP
FREE_DAILY_CAP_USD=50    # global daily ceiling across ALL free-tier spend
NEW_IP_PER_DAY=5         # max new IPs that can be granted free credit per day
FAMILY_MONTHLY_CAP_USD=200  # monthly aggregate across all family tokens
MONTHLY_CAP_USD=300         # overall monthly ceiling across free + family

# --- Request limits ---------------------------------------------------------
MAX_TOKENS_CAP=32000     # hard ceiling injected as max_tokens (bounds one runaway gen; credit balance is the real cost guard)
MAX_INPUT_CHARS=200000   # reject absurdly large request bodies

# --- Wiring -----------------------------------------------------------------
OPENROUTER_BASE=https://openrouter.ai/api/v1
SEARXNG_BASE=http://127.0.0.1:8888   # self-hosted SearXNG backing /v1/web-search (JSON; auth-gated). Prod overrides to the GPU-host instance.
EMBED_BASE=http://127.0.0.1:8899     # self-hosted embedding-inference (HF text-embeddings-inference) backing /v1/embed (memory dedup). Prod overrides to the GPU host.
ALLOWED_ORIGIN=http://localhost:5173   # the frontend origin (CORS); comma-separated for several
DB_PATH=./myriapod-proxy.db
HOST=0.0.0.0
PORT=8790

# --- Voice-session broker ---------------------------------------------------
# Load-balances browser voice sessions across the moshi instance(s). Leases are
# in-memory + ephemeral (concurrency state, not money — a restart resets counts).
#
# Single instance (default — staging behaves like the current live demo): leave
# VOICE_INSTANCES unset; the one instance is built from these two WS bases.
VOICE_STT_BASE=ws://localhost:8123/api/asr-streaming
VOICE_TTS_BASE=ws://localhost:8123/api/tts_streaming
#
# Two instances (prod): set VOICE_INSTANCES to a JSON array of {sttUrl,ttsUrl}.
# The two instances live on the SAME origin, distinguished by URL path (keeps the
# frontend CSP's connect-src untouched). Example:
# VOICE_INSTANCES=[{"sttUrl":"wss://HOST/api/asr-streaming","ttsUrl":"wss://HOST/api/tts_streaming"},{"sttUrl":"wss://HOST/api/asr-streaming-2","ttsUrl":"wss://HOST/api/tts_streaming-2"}]
#
VOICE_INSTANCE_CAPACITY=1   # per-instance max concurrent leases = the moshi STT batch_size (live: 1; prod bumps this)
VOICE_HEARTBEAT_SEC=60      # browser keepalive interval; a lease is reclaimed after 3x without a beat
